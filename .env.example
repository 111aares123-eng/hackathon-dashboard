# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL Database (Docker Compose or local/hosted instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_portal"

# Authentication (NextAuth / Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-string-in-local-env"

# Institutional Domain Verification (Configured for Rajalakshmi Engineering College)
ALLOWED_INSTITUTIONAL_DOMAINS="rajalakshmi.edu.in"

# Email Delivery Configuration
# EMAIL_PROVIDER options:
# - "console": Development mode; outputs verification links to terminal without sending network requests
# - "resend": Production delivery via Resend HTTPS API (requires RESEND_API_KEY)
# - "mock": Testing mode; queues emails in-memory for assertion tests
EMAIL_PROVIDER="console"
EMAIL_FROM="REC AI & DS Opportunities Portal <noreply@rajalakshmi.edu.in>"
RESEND_API_KEY=""

# Optional OAuth Credentials (Leave empty unless configured)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
